// ────────────── Window & Layer Rules ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Window-Rules

// Rounded corners on every window.
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

// Subtle transparency on the terminal (active/inactive).
window-rule {
    match app-id="Alacritty"
    opacity 0.95
}

// Steam: float its sub-windows, keep the main window tiled.
window-rule {
    match app-id="steam"
    exclude title=r#"^[Ss]team$"#
    open-floating true
}
window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

// Calamares floats only in a VM: the live-ISO autostart line copies calamares-vm.rule to
// calamares-vm.kdl when systemd-detect-virt finds one. On real metal the file is absent and
// the installer tiles like any other window.
include optional=true "calamares-vm.kdl"

// noctalia draws the wallpaper into niri's backdrop (shows through the overview).
layer-rule {
    match namespace="^noctalia-wallpaper*"
    place-within-backdrop true
}
