// ────────────── Startup Applications ──────────────
// niri does not process /etc/xdg/autostart, so everything starts here.
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-at-startup

// XWayland: niri (25.08+) starts xwayland-satellite on demand and exports DISPLAY itself,
// picking a free display number. Don't spawn it here or pin DISPLAY: on an installed system
// SDDM's greeter Xorg keeps :0, so a hardcoded :0 breaks every X11 app (VLC, Calamares).

// The whole desktop: noctalia v5 (bar, launcher, lock, notifications,
// wallpaper, control center, session menu, built-in polkit agent).
spawn-sh-at-startup "noctalia"

// Qt look: KvGnomeDark (matches adw-gtk3-dark) unless the user picked an installed Kvantum theme.
// The helper comes from kiro-wayland-dotfiles (a dependency).
spawn-at-startup "kiro-kvantum-default"

// First login of an installed system: use the keyboard layout picked in the installer
// (/etc/vconsole.conf XKBLAYOUT/XKBVARIANT) instead of the us,be default in cfg/input.kdl.
// No-op on the live ISO and when the user already changed the layout.
spawn-sh-at-startup "~/.config/kiro-niri-noctalia/scripts/keyboard-from-installer.sh"

// Create the XDG user dirs (Documents, Music, Pictures, …) on first login —
// niri doesn't run the xdg-user-dirs autostart, so do it explicitly. Idempotent.
spawn-at-startup "xdg-user-dirs-update"

// Live ISO only: auto-launch the Calamares installer. Gated on the archiso
// boot mount so it never fires on an installed system; kiro_final strips this
// line on install.
// In a VM it first enables cfg/calamares-vm.rule (float, 1024 wide, 85% high) and waits for niri to reload.
spawn-sh-at-startup "[ -d /run/archiso/bootmnt ] && { systemd-detect-virt -q && cp ~/.config/kiro-niri-noctalia/cfg/calamares-vm.rule ~/.config/kiro-niri-noctalia/cfg/calamares-vm.kdl && sleep 1; exec calamares_polkit -d -style kvantum; }"
